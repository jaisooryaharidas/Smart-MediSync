# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Gemini 2.5 models were scheduled to shut down on 16 Oct 2026. Copy a current Flash model ID from AI Studio if this alias fails.
GEMINI_MODEL=gemini-flash-latest
# Any long random string; used to sign login tokens
AUTH_SECRET=change-me-to-a-long-random-string
PORT=4000
